{
  "schema_version": "1.0",
  "default_policy": "deny",
  "global_forbidden": [
    ".git/**",
    "**/.env",
    "**/.env.*",
    "**/secrets/**",
    "**/*credential*",
    "**/*private_key*"
  ],
  "shared_orchestrator_only": [
    "docs/agent-authoring/session-collaboration/MASTER_WORKSTREAM_BOARD.yaml",
    "docs/agent-authoring/session-collaboration/WORKSTREAM_BOUNDARIES.json"
  ],
  "workstreams": [
    {
      "branch_pattern": "orchestration/session-collaboration-framework",
      "owner_role": "orchestrator",
      "writable_paths": [
        "docs/agent-authoring/session-collaboration/**",
        ".github/workflows/workstream-boundary-check.yml"
      ],
      "read_only_paths": [],
      "forbidden_paths": []
    },
    {
      "branch_pattern": "research/agent-workflow-assembler",
      "owner_role": "research_session",
      "writable_paths": [
        "docs/agent-authoring/workstreams/agent-workflow-assembler-research/**",
        "docs/agent-authoring/research-results/05_AGENT_WORKFLOW_ASSEMBLER_심층조사.md"
      ],
      "read_only_paths": [
        ".claude/**",
        "docs/agent-authoring/workstreams/agent-workflow-assembler-research/inputs/**"
      ],
      "forbidden_paths": [
        ".claude/settings.json",
        ".github/**",
        "docs/agent-authoring/evidence/**"
      ]
    },
    {
      "branch_pattern": "research/external-capability-discovery",
      "owner_role": "research_session",
      "writable_paths": [
        "docs/agent-authoring/workstreams/external-capability-discovery-research/**",
        "docs/agent-authoring/research-results/06_EXTERNAL_CAPABILITY_DISCOVERY_REUSE_ADVISOR_심층조사.md"
      ],
      "read_only_paths": [
        ".claude/**",
        "docs/agent-authoring/workstreams/external-capability-discovery-research/inputs/**"
      ],
      "forbidden_paths": [
        ".claude/settings.json",
        ".github/**",
        "docs/agent-authoring/evidence/**"
      ]
    },
    {
      "branch_pattern": "recovery/upstream-builders",
      "owner_role": "implementation_session",
      "writable_paths": [
        ".claude/skills/capability-artifact-planner/**",
        ".claude/skills/gate-generator/**",
        ".claude/skills/execution-artifact-generator/**",
        ".claude/agents/capability-plan-auditor.md",
        ".claude/agents/gate-auditor.md",
        ".claude/agents/execution-artifact-auditor.md",
        "docs/agent-authoring/evidence/capability-planner/**",
        "docs/agent-authoring/evidence/gate-generator/**",
        "docs/agent-authoring/evidence/execution-artifact-generator/**",
        "docs/agent-authoring/CAPABILITY_ARTIFACT_PLANNER_구현결과.md",
        "docs/agent-authoring/GATE_GENERATOR_MVP_구현결과.md",
        "docs/agent-authoring/EXECUTION_ARTIFACT_GENERATOR_MVP_구현결과.md",
        "docs/agent-authoring/workstreams/upstream-recovery/**"
      ],
      "read_only_paths": [
        "docs/agent-authoring/workstreams/upstream-recovery/inputs/**"
      ],
      "forbidden_paths": [
        ".claude/settings.json",
        ".github/**",
        "docs/agent-authoring/evidence/knowledge-rag-builder/**"
      ]
    },
    {
      "branch_pattern": "codex/knowledge-rag-builder-k0-k6",
      "owner_role": "implementation_session",
      "writable_paths": [
        ".claude/skills/knowledge-rag-builder/**",
        ".claude/agents/knowledge-rag-auditor.md",
        "docs/agent-authoring/evidence/knowledge-rag-builder/**",
        "docs/agent-authoring/KNOWLEDGE_RAG_BUILDER_MVP_구현결과.md",
        "docs/agent-authoring/CURRENT_WORK_STATE.yaml",
        "docs/agent-authoring/HANDOFF_LOG.md",
        "docs/agent-authoring/OUTPUT_MANIFEST.yaml"
      ],
      "read_only_paths": [
        ".claude/skills/capability-artifact-planner/**",
        ".claude/skills/gate-generator/**",
        ".claude/skills/execution-artifact-generator/**",
        "docs/agent-authoring/evidence/capability-planner/**",
        "docs/agent-authoring/evidence/gate-generator/**",
        "docs/agent-authoring/evidence/execution-artifact-generator/**",
        "docs/agent-authoring/CODEX_KNOWLEDGE_RAG_BUILDER_K0_K6_WORK_ORDER.md",
        "docs/agent-authoring/CODEX_COLLABORATION_PROTOCOL.md",
        "docs/agent-authoring/CODEX_SESSION_START_PROMPT.md"
      ],
      "forbidden_paths": [
        ".claude/settings.json",
        ".github/**"
      ]
    }
  ]
}
